{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "target": "ES2022",
    "noEmitOnError": true,
    "types": ["jest"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "isolatedModules": true       
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}